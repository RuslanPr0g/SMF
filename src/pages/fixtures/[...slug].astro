---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import DossierLayout from '../../layouts/DossierLayout.astro';
import { listFixtures } from '../../lib/archive';

export const getStaticPaths = (async () => {
  const fixtures = await listFixtures();
  return fixtures.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const rows: Array<[string, string | undefined]> = [
  ['Location', d.location],
  ['Clearance', `Level ${d.clearance}`],
  ['Date Filed', d.filed.toISOString().slice(0, 10)],
];
---

<DossierLayout
  serial={d.id}
  title={d.title}
  summary={d.summary}
  rows={rows}
  pitch={d.status === 'pitch'}
>
  <Content />
</DossierLayout>
